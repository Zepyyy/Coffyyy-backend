generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model User {
    // Internal owner record; password remains inaccessible to browser roles.
    id              Int             @id @default(autoincrement())
    username        String          @unique @default("")
    password        String
    sessions        Session[]
    syncCodes       SyncCode[]
    createdAt       DateTime        @default(now())
    updatedAt       DateTime        @updatedAt
    snapshotVersion Int             @default(0)
    snapshot        Json?
}

model Session {
    // Cookie session material; token and CSRF values are stored as hashes.
    id              String    @id @default(uuid())
    tokenHash       String    @unique
    csrfTokenHash   String
    userId          Int
    createdAt       DateTime  @default(now())
    lastSeenAt      DateTime  @default(now())
    expiresAt       DateTime
    absoluteExpiresAt DateTime
    revokedAt       DateTime?
    user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([expiresAt])
}

model SyncCode {
    // One active, reusable pairing code per workspace; plaintext never persisted.
    id         String   @id @default(uuid())
    codeHash   String   @unique
    userId     Int      @unique
    createdAt  DateTime @default(now())
    user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
