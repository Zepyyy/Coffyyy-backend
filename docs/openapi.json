{
  "openapi": "3.0.3",
  "info": {
    "title": "Coffyyy API",
    "description": "The Coffyyy backend API for managing coffee workspaces, beans, machines, and brews.\n\n## Authentication\nThis API uses a cookie-based session system with CSRF protection. All requests\n(except public endpoints) require:\n- A valid `coffyyy_session` cookie\n- A valid `X-CSRF-Token` header or `coffyyy_csrf` cookie\n\n## Workspace Access\n- Use `/auth/sync/enable` to create a new workspace and get a sync code\n- Use `/auth/sync/pair` with an existing sync code to access a workspace\n- Session endpoints manage the current authenticated session",
    "version": "0.2.0",
    "contact": {
      "name": "Coffyyy",
      "url": "https://coffyyy.quentinstubecki.fr"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000/api",
      "description": "Local development server"
    },
    {
      "url": "https://coffyyy-backend.onrender.com/api",
      "description": "Production server"
    },
    {
      "url": "https://coffyyy.quentinstubecki.fr/api",
      "description": "Production frontend API"
    }
  ],
  "security": [
    {
      "csrf": []
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": ["App"],
        "summary": "Root endpoint",
        "description": "Legacy root endpoint that returns a simple message",
        "operationId": "getHello",
        "responses": {
          "200": {
            "description": "Service is running",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "Hello World!"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Health check",
        "description": "Returns the current health status of the service including database connectivity. This is the proper health check endpoint. No authentication required.",
        "operationId": "getHealth",
        "security": [],
        "responses": {
          "200": {
            "description": "Service health status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    },
    "/auth/sync/csrf": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Get CSRF token",
        "description": "Returns a new CSRF token and sets the CSRF cookie. This endpoint is public and can be used to bootstrap the authentication flow.",
        "operationId": "getCsrf",
        "security": [],
        "responses": {
          "200": {
            "description": "CSRF token generated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CsrfResponse"
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "description": "Contains the CSRF cookie",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/auth/sync/enable": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Create workspace and sync code",
        "description": "Creates a new workspace, session, and generates a permanent reusable sync code. This is the first step for new users to create their workspace.",
        "operationId": "enableSync",
        "security": [],
        "requestBody": {
          "description": "No body required, but CSRF validation is performed",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Workspace and session created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnableSyncResponse"
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "description": "Contains session and CSRF cookies",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/CsrfInvalid"
          }
        }
      }
    },
    "/auth/sync/pair": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Pair with existing workspace",
        "description": "Connects to an existing workspace using a sync code. The sync code is reusable and does not expire. Creates a new session for the workspace.",
        "operationId": "pair",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SyncRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Session created for existing workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PairResponse"
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "description": "Contains session and CSRF cookies",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/CsrfInvalid"
          },
          "404": {
            "description": "Sync code not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/sync/session": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Get current session info",
        "description": "Returns information about the current authenticated session",
        "operationId": "getSession",
        "responses": {
          "200": {
            "description": "Current session information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/auth/sync/logout": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Logout current session",
        "description": "Revokes the current session and clears session cookies",
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Successfully logged out",
            "headers": {
              "Set-Cookie": {
                "description": "Clears session cookies",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/auth/sync/code/rotate": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Rotate sync code",
        "description": "Generates a new sync code for the workspace, invalidating the previous one. The new code is returned in the response.",
        "operationId": "rotateCode",
        "responses": {
          "200": {
            "description": "New sync code generated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RotateCodeResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/auth/sync/sessions/revoke": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Revoke all sessions",
        "description": "Revokes all active sessions for the current workspace, then clears the current browser cookies.",
        "operationId": "revokeSessions",
        "responses": {
          "204": {
            "description": "All sessions revoked",
            "headers": {
              "Set-Cookie": {
                "description": "Clears session cookies",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/workspace/snapshot": {
      "get": {
        "tags": ["Workspace"],
        "summary": "Get workspace snapshot",
        "description": "Returns the current workspace snapshot containing beans, machines, and brews. The snapshot includes version information for optimistic concurrency control.",
        "operationId": "getSnapshot",
        "responses": {
          "200": {
            "description": "Current workspace snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SnapshotResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Workspace not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["Workspace"],
        "summary": "Update workspace snapshot",
        "description": "Updates the workspace snapshot with new data. Uses If-Match header for optimistic concurrency control to prevent overwriting changes.",
        "operationId": "putSnapshot",
        "parameters": [
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Snapshot"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Snapshot updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SnapshotResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid snapshot data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Workspace not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Snapshot version conflict - data has changed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "csrf": {
        "type": "apiKey",
        "name": "X-CSRF-Token",
        "in": "header",
        "description": "CSRF token for request validation"
      }
    },
    "parameters": {
      "IfMatch": {
        "name": "If-Match",
        "in": "header",
        "description": "Current snapshot version for optimistic concurrency control",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[\\d]+$",
          "example": "0"
        }
      }
    },
    "schemas": {
      "HealthStatus": {
        "type": "object",
        "description": "Service health status with dependency checks",
        "properties": {
          "status": {
            "type": "string",
            "description": "Overall health status",
            "enum": ["healthy", "unhealthy"],
            "example": "healthy"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "When the health check was performed",
            "example": "2025-01-01T00:00:00.000Z"
          },
          "version": {
            "type": "string",
            "description": "API version",
            "example": "0.2.0"
          },
          "checks": {
            "type": "object",
            "description": "Individual health checks",
            "properties": {
              "database": {
                "$ref": "#/components/schemas/DatabaseHealth"
              }
            },
            "required": ["database"]
          }
        },
        "required": ["status", "timestamp", "version", "checks"]
      },
      "DatabaseHealth": {
        "type": "object",
        "description": "Database connectivity health check",
        "properties": {
          "status": {
            "type": "string",
            "description": "Database connection status",
            "enum": ["up", "down"],
            "example": "up"
          },
          "message": {
            "type": "string",
            "description": "Error message if database is down",
            "example": null
          }
        },
        "required": ["status"]
      },
      "CsrfResponse": {
        "type": "object",
        "properties": {
          "csrfRequired": {
            "type": "boolean",
            "description": "Indicates if CSRF is required for subsequent requests",
            "example": true
          },
          "csrfToken": {
            "type": "string",
            "description": "Current CSRF token",
            "example": "abc123def456"
          }
        },
        "required": ["csrfRequired", "csrfToken"]
      },
      "SyncRequest": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Permanent reusable workspace sync code",
            "example": "ABCD1234",
            "minLength": 1
          }
        },
        "required": ["code"]
      },
      "EnableSyncResponse": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "number",
            "description": "Unique identifier for the created workspace",
            "example": 1
          },
          "syncCode": {
            "type": "string",
            "description": "Permanent sync code for the workspace",
            "example": "ABCD1234"
          },
          "csrfToken": {
            "type": "string",
            "description": "CSRF token for the new session",
            "example": "abc123def456"
          }
        },
        "required": ["workspaceId", "syncCode", "csrfToken"]
      },
      "PairResponse": {
        "type": "object",
        "properties": {
          "connected": {
            "type": "boolean",
            "description": "Indicates successful connection",
            "example": true
          },
          "workspaceId": {
            "type": "number",
            "description": "Unique identifier for the workspace",
            "example": 1
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "Expiration timestamp for the session",
            "example": "2025-01-01T00:00:00.000Z"
          },
          "csrfToken": {
            "type": "string",
            "description": "CSRF token for the new session",
            "example": "abc123def456"
          }
        },
        "required": ["connected", "workspaceId", "expiresAt", "csrfToken"]
      },
      "SessionInfo": {
        "type": "object",
        "properties": {
          "sub": {
            "type": "number",
            "description": "User ID (workspace owner)",
            "example": 1
          },
          "sessionId": {
            "type": "string",
            "description": "Current session ID",
            "example": "session-uuid-string"
          },
          "workspaceId": {
            "type": "number",
            "description": "Workspace ID",
            "example": 1
          }
        },
        "required": ["sub", "sessionId"]
      },
      "RotateCodeResponse": {
        "type": "object",
        "properties": {
          "syncCode": {
            "type": "string",
            "description": "New sync code for the workspace",
            "example": "NEWCODE123"
          }
        },
        "required": ["syncCode"]
      },
      "Snapshot": {
        "type": "object",
        "description": "Complete workspace data",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "type": "number",
            "enum": [1]
          },
          "beans": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Bean"
            }
          },
          "machines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Machine"
            }
          },
          "brews": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Brew"
            }
          }
        },
        "required": ["schemaVersion", "beans", "machines", "brews"]
      },
      "SnapshotResponse": {
        "type": "object",
        "properties": {
          "snapshot": {
            "$ref": "#/components/schemas/Snapshot"
          },
          "version": {
            "type": "number",
            "description": "Current snapshot version for concurrency control",
            "example": 0
          }
        },
        "required": ["snapshot", "version"]
      },
      "Bean": {
        "type": "object",
        "description": "Coffee bean record",
        "additionalProperties": false,
        "properties": {
          "localId": {
            "type": "string",
            "description": "Stable client-generated ID, unique per entity type"
          },
          "name": {
            "type": "string"
          },
          "rating": {
            "type": "number",
            "description": "0-5"
          },
          "roastLevel": {
            "type": "number"
          },
          "origin": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "process": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "variety": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "brand": {
            "type": "string"
          },
          "flavors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": ["Excellent", "Good", "Mid", "Horrible", "New", ""]
          },
          "dominantNote": {
            "type": "string",
            "enum": [
              "Fruity",
              "Nutty",
              "Floral",
              "Sweet",
              "Sour",
              "Spices",
              "Roasted",
              "Green",
              ""
            ]
          },
          "botanic": {
            "type": "string",
            "enum": ["Arabica", "Robusta", ""]
          },
          "designation": {
            "type": "string",
            "enum": ["Pure Origin", "Blend", ""]
          },
          "finished": {
            "type": "boolean"
          }
        },
        "required": [
          "localId",
          "name",
          "rating",
          "roastLevel",
          "origin",
          "process",
          "variety",
          "brand",
          "flavors",
          "status",
          "dominantNote",
          "botanic",
          "designation",
          "finished"
        ]
      },
      "Machine": {
        "type": "object",
        "description": "Coffee machine or equipment record",
        "additionalProperties": false,
        "properties": {
          "localId": {
            "type": "string",
            "description": "Stable client-generated ID, unique per entity type"
          },
          "name": {
            "type": "string"
          },
          "brand": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "purchaseDate": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "grindRange": {
            "type": "string"
          },
          "capacity": {
            "type": "string"
          }
        },
        "required": [
          "localId",
          "name",
          "brand",
          "type",
          "purchaseDate",
          "model",
          "grindRange",
          "capacity"
        ]
      },
      "Brew": {
        "type": "object",
        "description": "Coffee brew record; bean/machine reference snapshot localIds",
        "additionalProperties": false,
        "properties": {
          "localId": {
            "type": "string",
            "description": "Stable client-generated ID, unique per entity type"
          },
          "beanLocalId": {
            "type": "string",
            "description": "Bean localId"
          },
          "machineLocalId": {
            "type": "string",
            "description": "Machine localId"
          },
          "beanWeight": {
            "type": "number"
          },
          "espressoWeight": {
            "type": "number"
          },
          "grindSize": {
            "type": "number"
          },
          "overallRating": {
            "type": "number"
          },
          "tasteScore": {
            "type": "number",
            "description": "-5 sour/under-extracted to +5 bitter/over-extracted"
          },
          "strengthScore": {
            "type": "number",
            "description": "-5 weak to +5 strong"
          },
          "extractionTime": {
            "type": "string"
          },
          "flow": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "description": "ISO 8601 date-time"
          }
        },
        "required": [
          "localId",
          "beanWeight",
          "espressoWeight",
          "grindSize",
          "date"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "description": "HTTP status code",
            "example": 400
          },
          "message": {
            "type": "string",
            "description": "Error message",
            "example": "Bad Request"
          },
          "error": {
            "type": "string",
            "description": "Error type",
            "example": "Bad Request"
          }
        },
        "required": ["statusCode", "message", "error"]
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Unauthorized - no valid session",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "statusCode": 401,
              "message": "Unauthorized",
              "error": "Unauthorized"
            }
          }
        }
      },
      "CsrfInvalid": {
        "description": "Forbidden - invalid or missing CSRF token",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "statusCode": 403,
              "message": "Invalid CSRF token",
              "error": "Forbidden"
            }
          }
        }
      }
    }
  }
}
